###############################################
### LightRAG Production Environment Example ###
###############################################

#######################
### Server Settings ###
#######################
HOST=0.0.0.0
PORT=9621
DEBUG=false

# Custom WebUI branding
WEBUI_TITLE=My Knowledge Base
WEBUI_DESCRIPTION=AI-Powered Document Search

############################
### Authentication Setup ###
############################
# Add user accounts (format: user1:password1,user2:password2)
AUTH_ACCOUNTS=admin:adminpassword,user1:user1password

# JWT Configuration (auto-generated on restart, users must re-login)
# TOKEN_SECRET=your-fixed-secret-here  # Uncomment to persist sessions across restarts
TOKEN_EXPIRE_HOURS=5
GUEST_TOKEN_EXPIRE_HOURS=24

########################
### Rate Limiting    ###
########################
ENABLE_RATE_LIMITING=true
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_QUERIES_PER_MINUTE=30
RATE_LIMIT_SCANS_PER_MINUTE=5

#########################
### LLM Configuration ###
#########################
LLM_BINDING=gemini
LLM_MODEL=gemini-2.0-flash
LLM_BINDING_API_KEY=your_gemini_api_key_here
LLM_BINDING_HOST=https://generativelanguage.googleapis.com

###############################
### Embedding Configuration ###
###############################
EMBEDDING_BINDING=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_API_KEY=your_gemini_api_key_here
EMBEDDING_BINDING_HOST=https://generativelanguage.googleapis.com
EMBEDDING_SEND_DIM=true

################################
### PostgreSQL Configuration ###
################################
POSTGRES_HOST=postgres        # Use 'localhost' for local dev, 'postgres' for Docker
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DATABASE=lightrag_db
POSTGRES_MAX_CONNECTIONS=24

# Vector index configuration
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

##########################
### Redis Configuration ###
##########################
REDIS_URI=redis://redis:6379  # Use 'redis://localhost:6379' for local dev

################################
### Storage Configuration    ###
### Full PostgreSQL for prod ###
################################
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

###############################
### Performance Tuning      ###
###############################
MAX_ASYNC=8
MAX_PARALLEL_INSERT=4
EMBEDDING_FUNC_MAX_ASYNC=8
EMBEDDING_BATCH_NUM=10

###############################
### Query Configuration     ###
###############################
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
TOP_K=40
CHUNK_TOP_K=20
SUMMARY_LANGUAGE=English
